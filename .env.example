# Copia este archivo a .env.local y complétalo (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Mapbox > Account > Access tokens: token PÚBLICO (pk.*), restringido por URL. Para el mapa 3D y las rutas a pie.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Clave PÚBLICA de las notificaciones push (npx web-push generate-vapid-keys). La app la usa para suscribir cada teléfono.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# SOLO servidor (Vercel > Settings > Environment Variables). NUNCA con prefijo VITE_ ni en el navegador.
# Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notificaciones push (solo servidor): la misma clave pública, la privada, el contacto y una clave inventada
# que comparten Vercel y la base de datos para autorizar los envíos (ver la wiki: Despliegue y configuración).
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=https://your-app.vercel.app
PUSH_SECRET=your-long-invented-secret
