# Copia este archivo a .env.local y complétalo (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Mapbox > Account > Access tokens: token PÚBLICO (pk.*), restringido por URL. Para el mapa 3D y las rutas a pie.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# SOLO servidor (Vercel > Settings > Environment Variables). NUNCA con prefijo VITE_ ni en el navegador.
# Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
